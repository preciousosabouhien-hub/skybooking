# PostgreSQL connection string from your production database provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate a long random secret. Do not reuse the development value.
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Render supplies PORT automatically. Keep this fallback for local execution.
PORT=4000

# Comma-separated list of allowed frontend origins.
# Example: https://skybook.vercel.app,https://www.yourdomain.com
CLIENT_URL="https://YOUR-FRONTEND-DOMAIN"
